{
  "name": "cron-scheduler-service",
  "version": "1.0.0",
  "description": "Distributed cron with lease-based leader election: a zero-dependency scheduler engine with four election backends (memory, file, Redis, HTTP CAS), durable job and run stores, per-job timeout/retry/overlap/misfire policies, an append-only run journal and an HTTP control plane.",
  "type": "module",
  "license": "MIT",
  "author": "Retsumdk",
  "homepage": "https://github.com/Retsumdk/cron-scheduler-service#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Retsumdk/cron-scheduler-service.git"
  },
  "bugs": {
    "url": "https://github.com/Retsumdk/cron-scheduler-service/issues"
  },
  "keywords": [
    "cron",
    "cron-scheduler",
    "scheduler",
    "job-scheduler",
    "distributed",
    "leader-election",
    "lease",
    "high-availability",
    "redis",
    "etcd",
    "consul",
    "bun",
    "node",
    "typescript",
    "zero-dependency"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "cron-scheduler-service": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json && bun build src/index.ts src/cli.ts --outdir dist --target node",
    "start": "bun src/cli.ts serve",
    "cli": "bun src/cli.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.0"
  }
}
